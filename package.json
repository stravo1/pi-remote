{
  "name": "pi-remote",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "npm test --workspaces",
    "check": "npm run check --workspaces",
    "build": "npm run build -w web",
    "start": "npm start -w server --",
    "prepare": "node --input-type=module -e \"try { console.log((await import('husky')).default()); } catch (error) { if (error.code !== 'ERR_MODULE_NOT_FOUND') throw error; }\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10"
  }
}
