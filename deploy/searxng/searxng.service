[Unit]
Description=SearXNG search for pi
After=network-online.target

[Service]
WorkingDirectory=%h/searxng/src
Environment=SEARXNG_SETTINGS_PATH=%h/.config/searxng/settings.yml
ExecStart=%h/searxng/venv/bin/granian --interface wsgi --host 127.0.0.1 --port 8888 searx.webapp:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
